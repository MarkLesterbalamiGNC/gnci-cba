# Uploaded photos: ONLY plain image files may be downloaded from here, and
# nothing in this folder can ever be run as a script - even if a hacker managed
# to upload one.
<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "(?i)^[A-Za-z0-9_.\-]+\.(jpe?g|png|gif)$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "(?i)^[A-Za-z0-9_.\-]+\.(jpe?g|png|gif)$">
        Allow from all
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
</IfModule>
